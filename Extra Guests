import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        // Read input values
        int X = sc.nextInt(); // Expected guests
        int Y = sc.nextInt(); // Actual guests
        
        // Cost for expected guests
        int initialCost = X * 100;
        
        // Extra guests
        int extraGuests = Y - X;
        
        // Cost for extra guests
        int extraCost = extraGuests * 150;
        
        // Total cost
        int totalCost = initialCost + extraCost;
        
        // Print result
        System.out.println(totalCost);
        
        sc.close();
    }
}
